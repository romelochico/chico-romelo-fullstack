NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ADMIN_EMAILS=email1@example.com,email2@example.com

# Server-only bootstrap admin — always tier 'admin' regardless of the
# database, so a bad team_members row can never lock the admin out. See
# src/lib/api-auth.ts and src/middleware.ts.
SUPER_ADMIN_EMAIL=<admin-email>

NEXT_PUBLIC_FORMSPREE_ID=<formspree-form-id>

# Server-only. Encrypts credentials.password at rest (src/lib/crypto.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=<random-base64-secret>

# nboxes é a fonte de verdade para ensaios (calendario_eventos.tipo = 'ensaio').
# Usadas apenas em src/lib/nboxes.ts (server-side), nunca expostas ao browser.
NBOXES_API_URL=https://<nboxes-deployment>
NBOXES_API_KEY=<mesma REHEARSALS_API_KEY configurada no nboxes>
NBOXES_REHEARSAL_EMAIL=romelochico@gmail.com
